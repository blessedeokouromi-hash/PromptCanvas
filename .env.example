# ===== PromptCanvas AI environment variables =====
# Set these in Vercel: Project > Settings > Environment Variables.
# Never put any secret in code or in any file that is committed.

# Supabase (Project Settings > API)
# URL + anon key are public and also live in supabase-config.json.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key (secret! Server-only. Used to write profiles, credits, storage.)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin access: comma-separated email addresses of admins
ADMIN_EMAILS=you@example.com

# Paystack (https://dashboard.paystack.com > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=sk_live_or_sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_or_pk_test_xxx

# Flutterwave (https://dashboard.flutterwave.com > Settings > API)
FLUTTERWAVE_SECRET_KEY=FLWSECK_xxx
FLW_WEBHOOK_HASH=any-long-random-string   # same string you type in Flutterwave webhook settings

# AI providers (all optional; Pollinations works with NO key)
POLLINATIONS_TOKEN=    # free token from https://enter.pollinations.ai - turns on prompt editing, background swap, portrait and image-to-image
REMOVEBG_KEY=        # enables real AI background removal (free 50/month)
REPLICATE_API_TOKEN= # enables real upscaling and object removal
